# Public, machine-independent SSH defaults.
#
# Keep hostnames, users, ports, jump hosts and identity paths in:
#   ~/.ssh/config.local
#
# Load private configuration before this file because OpenSSH uses the first
# value found for most settings.

Host *
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPersist 10m
    ControlPath ~/.ssh/cm-%C
